# =============================================================================
# Secrets Alertmanager — NE PAS COMMITER ce fichier (.gitignore)
# Copier en .env.alertmanager et remplir les valeurs
# =============================================================================

# Email destinataire des alertes
ALERT_EMAIL=ton-email@example.com

# Slack — URL du webhook (Settings > Apps > Incoming Webhooks)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXX/YYYY/ZZZZ

# Discord — URL du webhook (Paramètres salon > Intégrations > Webhooks)
# Format : https://discord.com/api/webhooks/ID/TOKEN/slack
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXX/YYYY
